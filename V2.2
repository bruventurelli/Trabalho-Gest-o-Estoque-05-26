def relatorio_financeiro():
    """Valor total investido no estoque com ranking por valor."""
    with get_conn() as conn:
        linhas = conn.execute(
            "SELECT nome, preco, quantidade, (preco * quantidade) AS subtotal "
            "FROM produtos ORDER BY subtotal DESC"
        ).fetchall()
        total = conn.execute(
            "SELECT COALESCE(SUM(preco * quantidade), 0) AS total FROM produtos"
        ).fetchone()["total"]

    if not linhas:
        print("\n  [INFO] Nenhum produto cadastrado.")
        return

    print("\n  " + "─" * 62)
    print(f"  {'Produto':<24} {'Preço':>10} {'Qtd':>6} {'Subtotal':>14}")
    print("  " + "─" * 62)
    for l in linhas:
        print(f"  {l['nome']:<24} R$ {l['preco']:>7.2f} "
              f"{l['quantidade']:>6} R$ {l['subtotal']:>11.2f}")
    print("  " + "─" * 62)
    print(f"  VALOR TOTAL EM ESTOQUE: R$ {total:>11.2f}")
    print("  " + "─" * 62)


def exportar_csv(arquivo="relatorio_estoque.csv"):
    """Exporta estoque completo para CSV compatível com Excel (BR)."""
    with get_conn() as conn:
        produtos = conn.execute(
            "SELECT id, nome, categoria, preco, quantidade, "
            "(preco * quantidade) AS valor_total "
            "FROM produtos ORDER BY id"
        ).fetchall()

    if not produtos:
        print("\n  [INFO] Nenhum produto para exportar.")
        return

    with open(arquivo, mode="w", newline="", encoding="utf-8-sig") as f:
        # utf-8-sig: BOM que o Excel BR reconhece corretamente
        writer = csv.writer(f, delimiter=";")
        writer.writerow(["ID", "Nome", "Categoria", "Preço (R$)",
                         "Quantidade", "Valor Total (R$)"])
        for p in produtos:
            writer.writerow([p["id"], p["nome"], p["categoria"],
                             f"{p['preco']:.2f}".replace(".", ","),
                             p["quantidade"],
                             f"{p['valor_total']:.2f}".replace(".", ",")])

    print(f"\n  [OK] '{arquivo}' gerado com {len(produtos)} produto(s).")
    print("  Abra direto no Excel — separador ';' e vírgula decimal já configurados.")


def ver_historico(produto_id=None, limite=30):
    """
    Exibe histórico de movimentações.
    NOVO: aceita filtro por produto_id e limite configurável.
    """
    with get_conn() as conn:
        if produto_id:
            movs = conn.execute("""
                SELECT m.id, m.data_hora, m.tipo, m.quantidade, p.nome AS produto
                FROM movimentacoes m
                LEFT JOIN produtos p ON p.id = m.produto_id
                WHERE m.produto_id = ?
                ORDER BY m.id DESC LIMIT ?
            """, (produto_id, limite)).fetchall()
        else:
            movs = conn.execute("""
                SELECT m.id, m.data_hora, m.tipo, m.quantidade, p.nome AS produto
                FROM movimentacoes m
                LEFT JOIN produtos p ON p.id = m.produto_id
                ORDER BY m.id DESC LIMIT ?
            """, (limite,)).fetchall()

    if not movs:
        print("\n  [INFO] Nenhuma movimentação encontrada.")
        return

    filtro_txt = f"produto ID {produto_id}" if produto_id else "todos os produtos"
    print(f"\n  Últimas {len(movs)} movimentações ({filtro_txt}):")
    print("  " + "─" * 67)
    print(f"  {'Data/Hora':<20} {'Tipo':<8} {'Qtd':>5}  Produto")
    print("  " + "─" * 67)
    for m in movs:
        produto = m["produto"] or "(produto removido)"
        sinal = "+" if m["tipo"] == "ENTRADA" else "-"
        print(f"  {m['data_hora']:<20} {m['tipo']:<8} "
              f"{sinal}{m['quantidade']:>4}  {produto}")
    print("  " + "─" * 67)


# =============================================================================
#  INTERFACE — listagem com paginação
# =============================================================================

def listar_todos(pagina=1):
    """
    NOVO: paginação — evita travar o terminal com muitos produtos.
    """
    with get_conn() as conn:
        total = conn.execute(
            "SELECT COUNT(*) AS c FROM produtos"
        ).fetchone()["c"]

        if total == 0:
            print("\n  [INFO] Nenhum produto cadastrado.")
            return

        total_paginas = max(1, -(-total // PAGE_SIZE))   # divisão teto
        pagina = max(1, min(pagina, total_paginas))
        offset = (pagina - 1) * PAGE_SIZE

        produtos = conn.execute(
            "SELECT * FROM produtos ORDER BY id LIMIT ? OFFSET ?",
            (PAGE_SIZE, offset)
        ).fetchall()

    print(f"\n  Página {pagina}/{total_paginas} — {total} produto(s) no total")
    print("  " + "─" * 67)
    print(f"  {'ID':<6} {'Nome':<22} {'Categoria':<14} {'Preço':>10} {'Qtd':>6}")
    print("  " + "─" * 67)
    for p in produtos:
        print(f"  {p['id']:<6} {p['nome']:<22} {p['categoria']:<14} "
              f"R$ {p['preco']:>7.2f} {p['quantidade']:>6}")
    print("  " + "─" * 67)

    if total_paginas > 1:
        print(f"  [P] Próxima  [A] Anterior  [I] Ir para página  [0] Voltar")
        nav = input("  Navegar: ").strip().upper()
        if nav == "P" and pagina < total_paginas:
            listar_todos(pagina + 1)
        elif nav == "A" and pagina > 1:
            listar_todos(pagina - 1)
        elif nav == "I":
            try:
                pg = int(input("  Página: "))
                listar_todos(pg)
            except ValueError:
                pass


def ler_inteiro(mensagem, minimo=None, maximo=None):
    while True:
        try:
            valor = int(input(mensagem))
            if minimo is not None and valor < minimo:
                print(f"  [ERRO] Mínimo: {minimo}.")
                continue
            if maximo is not None and valor > maximo:
                print(f"  [ERRO] Máximo: {maximo}.")
                continue
            return valor
        except ValueError:
            print("  [ERRO] Digite um número inteiro.")


def ler_float(mensagem, minimo=None):
    while True:
        try:
            valor = float(input(mensagem))
            if minimo is not None and valor < minimo:
                print(f"  [ERRO] Mínimo: {minimo}.")
                continue
            return valor
        except ValueError:
            print("  [ERRO] Digite um número válido.")


