def buscar_produto(termo):
    """
    NOVO — Busca produtos pelo nome (parcial, sem diferenciar maiúsculas).
    Útil para o dono que não lembra o ID mas sabe o nome.
    """
    with get_conn() as conn:
        resultados = conn.execute(
            "SELECT * FROM produtos WHERE nome LIKE ? ORDER BY nome COLLATE NOCASE",
            (f"%{termo}%",)
        ).fetchall()

    if not resultados:
        print(f"\n  [INFO] Nenhum produto encontrado para '{termo}'.")
        return []

    print(f"\n  Resultados para '{termo}':")
    print("  " + "─" * 60)
    print(f"  {'ID':<6} {'Nome':<22} {'Categoria':<14} {'Preço':>10} {'Qtd':>6}")
    print("  " + "─" * 60)
    for p in resultados:
        print(f"  {p['id']:<6} {p['nome']:<22} {p['categoria']:<14} "
              f"R$ {p['preco']:>7.2f} {p['quantidade']:>6}")
    print("  " + "─" * 60)
    return [dict(p) for p in resultados]


def filtrar_por_categoria(categoria):
    """
    NOVO — Lista todos os produtos de uma categoria.
    Útil para o dono ver só 'Limpeza' ou só 'Alimentos'.
    """
    with get_conn() as conn:
        produtos = conn.execute(
            "SELECT * FROM produtos WHERE categoria LIKE ? "
            "ORDER BY nome COLLATE NOCASE",
            (f"%{categoria}%",)
        ).fetchall()

    if not produtos:
        print(f"\n  [INFO] Nenhum produto na categoria '{categoria}'.")
        return

    print(f"\n  Categoria: {categoria}")
    print("  " + "─" * 60)
    print(f"  {'ID':<6} {'Nome':<24} {'Preço':>10} {'Qtd':>6} {'Valor':>12}")
    print("  " + "─" * 60)
    total = 0.0
    for p in produtos:
        valor = p['preco'] * p['quantidade']
        total += valor
        print(f"  {p['id']:<6} {p['nome']:<24} "
              f"R$ {p['preco']:>7.2f} {p['quantidade']:>6} "
              f"R$ {valor:>9.2f}")
    print("  " + "─" * 60)
    print(f"  {len(produtos)} produto(s)  |  Valor total na categoria: R$ {total:.2f}")


def editar_produto(produto_id):
    """
    NOVO — Permite corrigir nome, categoria e preço de um produto existente.
    Campo em branco mantém o valor atual.
    """
    with get_conn() as conn:
        p = conn.execute(
            "SELECT * FROM produtos WHERE id = ?", (produto_id,)
        ).fetchone()

    if p is None:
        print(f"  [ERRO] Produto ID {produto_id} não encontrado.")
        return

    print(f"\n  Editando: {p['nome']} (deixe em branco para manter o valor atual)")
    print("  " + "─" * 42)

    novo_nome      = input(f"  Nome [{p['nome']}]: ").strip() or p['nome']
    nova_categoria = input(f"  Categoria [{p['categoria']}]: ").strip() or p['categoria']

    # Preço — valida apenas se o usuário digitou algo
    while True:
        entrada = input(f"  Preço [R$ {p['preco']:.2f}]: ").strip()
        if not entrada:
            novo_preco = p['preco']
            break
        try:
            novo_preco = float(entrada)
            if novo_preco < 0:
                print("  [ERRO] Preço não pode ser negativo.")
                continue
            break
        except ValueError:
            print("  [ERRO] Digite um número válido.")

    try:
        with get_conn() as conn:
            conn.execute(
                "UPDATE produtos SET nome = ?, categoria = ?, preco = ? WHERE id = ?",
                (novo_nome, nova_categoria, round(novo_preco, 2), produto_id)
            )
        print(f"\n  [OK] Produto ID {produto_id} atualizado com sucesso.")
    except sqlite3.IntegrityError:
        print(f"  [ERRO] Já existe um produto '{novo_nome}' na categoria '{nova_categoria}'.")


def remover_produto(produto_id):
    """
    NOVO — Remove o produto após confirmação explícita.
    O histórico de movimentações é mantido (produto_id vira órfão — comportamento esperado).
    """
    with get_conn() as conn:
        p = conn.execute(
            "SELECT * FROM produtos WHERE id = ?", (produto_id,)
        ).fetchone()

    if p is None:
        print(f"  [ERRO] Produto ID {produto_id} não encontrado.")
        return

    print(f"\n  Produto: {p['nome']} | Qtd: {p['quantidade']} | Preço: R$ {p['preco']:.2f}")
    confirmacao = input("  ⚠  CONFIRMA a exclusão? Digite o nome do produto para confirmar: ").strip()

    if confirmacao != p['nome']:
        print("  [CANCELADO] Nome não confere. Nenhuma alteração foi feita.")
        return

    with get_conn() as conn:
        conn.execute("DELETE FROM produtos WHERE id = ?", (produto_id,))

    print(f"\n  [OK] Produto '{p['nome']}' removido do sistema.")


