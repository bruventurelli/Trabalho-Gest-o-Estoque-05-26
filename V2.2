    while True:
        opcao = menu_principal()

        # ── Produtos ─────────────────────────────────────────────────
        if opcao == "1":
            print("\n  --- CADASTRO ---")
            nome       = input("  Nome       : ")
            categoria  = input("  Categoria  : ")
            preco      = ler_float("  Preço R$   : ", minimo=0)
            quantidade = ler_inteiro("  Quantidade : ", minimo=0)
            cadastrar_produto(nome, categoria, preco, quantidade)

        elif opcao == "2":
            print("\n  --- EDITAR PRODUTO ---")
            pid = ler_inteiro("  ID do produto: ", minimo=1)
            editar_produto(pid)

        elif opcao == "3":
            print("\n  --- REMOVER PRODUTO ---")
            pid = ler_inteiro("  ID do produto: ", minimo=1)
            remover_produto(pid)

        elif opcao == "4":
            print("\n  --- BUSCAR POR NOME ---")
            termo = input("  Termo de busca: ").strip()
            if termo:
                buscar_produto(termo)

        elif opcao == "5":
            print("\n  --- FILTRAR POR CATEGORIA ---")
            cat = input("  Categoria: ").strip()
            if cat:
                filtrar_por_categoria(cat)

        elif opcao == "6":
            listar_todos()

        elif opcao == "7":
            print("\n  --- CONSULTAR PRODUTO ---")
            pid = ler_inteiro("  ID do produto: ", minimo=1)
            consultar_estoque(pid)

        # ── Estoque ──────────────────────────────────────────────────
        elif opcao == "8":
            print("\n  --- ENTRADA DE ESTOQUE ---")
            listar_todos()
            pid = ler_inteiro("  ID do produto: ", minimo=1)
            qtd = ler_inteiro("  Quantidade (+): ", minimo=1)
            registrar_entrada(pid, qtd)

        elif opcao == "9":
            print("\n  --- SAÍDA DE ESTOQUE ---")
            listar_todos()
            pid = ler_inteiro("  ID do produto: ", minimo=1)
            qtd = ler_inteiro("  Quantidade (-): ", minimo=1)
            registrar_saida(pid, qtd)

        elif opcao == "10":
            print("\n  --- ALERTA DE ESTOQUE BAIXO ---")
            limite = ler_inteiro("  Quantidade mínima aceitável: ", minimo=0)
            alertar_estoque_baixo(limite)

        # ── Relatórios ───────────────────────────────────────────────
        elif opcao == "11":
            print("\n  --- RELATÓRIO FINANCEIRO ---")
            relatorio_financeiro()

        elif opcao == "12":
            print("\n  --- EXPORTAR CSV ---")
            exportar_csv()

        elif opcao == "13":
            print("\n  --- HISTÓRICO DE MOVIMENTAÇÕES ---")
            filtrar = input("  Filtrar por produto? ID (ou ENTER para todos): ").strip()
            lim = ler_inteiro("  Quantas linhas exibir? [30]: ", minimo=1) \
                  if input("  Alterar limite? (s/N): ").strip().lower() == "s" else 30
            ver_historico(
                produto_id=int(filtrar) if filtrar.isdigit() else None,
                limite=lim
            )

        elif opcao == "0":
            print("\n  Até logo!\n")
            break

        else:
            print("\n  [ERRO] Opção inválida.")

        input("\n  Pressione ENTER para continuar...")


if __name__ == "__main__":
    main()
