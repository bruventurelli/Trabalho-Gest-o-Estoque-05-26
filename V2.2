

import sqlite3
import csv
import logging
from datetime import datetime
from contextlib import contextmanager

# ── Configuração ──────────────────────────────────────────────────────────────
DB_NAME  = "estoque.db"
LOG_FILE = "estoque.log"
PAGE_SIZE = 20          # itens por página na listagem

# ── Logging — erros ficam gravados em arquivo ──────────────────────────────────
logging.basicConfig(
    filename=LOG_FILE,
    level=logging.ERROR,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)


# =============================================================================
#  CONEXÃO — context manager garante fechamento mesmo em exceções
# =============================================================================

@contextmanager
def get_conn():
    """
    Uso:
        with get_conn() as conn:
            conn.execute(...)
    Faz commit automático ao sair sem erros; rollback se houver exceção.
    """
    conn = sqlite3.connect(DB_NAME)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")   # ativa integridade referencial
    try:
        yield conn
        conn.commit()
    except Exception as exc:
        conn.rollback()
        logging.error("Erro na transação: %s", exc, exc_info=True)
        raise
    finally:
        conn.close()


# =============================================================================
#  INICIALIZAÇÃO DO BANCO
# =============================================================================

def inicializar_banco():
    """Cria tabelas e índices se ainda não existirem."""
    with get_conn() as conn:
        # Produtos
        conn.execute("""
            CREATE TABLE IF NOT EXISTS produtos (
                id         INTEGER PRIMARY KEY AUTOINCREMENT,
                nome       TEXT    NOT NULL,
                categoria  TEXT    NOT NULL,
                preco      REAL    NOT NULL CHECK (preco >= 0),
                quantidade INTEGER NOT NULL DEFAULT 0 CHECK (quantidade >= 0),
                UNIQUE (nome, categoria)          -- NOVO: impede duplicatas
            )
        """)

        # Histórico de movimentações
        conn.execute("""
            CREATE TABLE IF NOT EXISTS movimentacoes (
                id          INTEGER PRIMARY KEY AUTOINCREMENT,
                produto_id  INTEGER NOT NULL,
                tipo        TEXT    NOT NULL CHECK (tipo IN ('ENTRADA','SAIDA')),
                quantidade  INTEGER NOT NULL CHECK (quantidade > 0),
                data_hora   TEXT    NOT NULL,
                FOREIGN KEY (produto_id) REFERENCES produtos(id)
            )
        """)

        # NOVO: índices para acelerar buscas em produção
        conn.execute("""
            CREATE INDEX IF NOT EXISTS idx_produtos_nome
            ON produtos (nome COLLATE NOCASE)
        """)
        conn.execute("""
            CREATE INDEX IF NOT EXISTS idx_produtos_categoria
            ON produtos (categoria COLLATE NOCASE)
        """)
        conn.execute("""
            CREATE INDEX IF NOT EXISTS idx_mov_produto
            ON movimentacoes (produto_id)
        """)


# =============================================================================
#  FUNÇÕES OBRIGATÓRIAS (mesma assinatura da v1, corrigidas internamente)
# =============================================================================

def cadastrar_produto(nome, categoria, preco, quantidade):
    """Insere um novo produto. Retorna o ID ou None em caso de erro."""
    # Validações
    if not nome.strip():
        print("  [ERRO] O nome do produto não pode ser vazio.")
        return None
    if not categoria.strip():
        print("  [ERRO] A categoria não pode ser vazia.")
        return None
    if preco < 0:
        print("  [ERRO] O preço não pode ser negativo.")
        return None
    if quantidade < 0:
        print("  [ERRO] A quantidade inicial não pode ser negativa.")
        return None

    try:
        with get_conn() as conn:
            # CORREÇÃO: tudo na mesma transação — INSERT produto + INSERT movimentação
            cur = conn.execute(
                "INSERT INTO produtos (nome, categoria, preco, quantidade) "
                "VALUES (?, ?, ?, ?)",
                (nome.strip(), categoria.strip(), round(preco, 2), int(quantidade))
            )
            produto_id = cur.lastrowid

            if quantidade > 0:
                conn.execute(
                    "INSERT INTO movimentacoes (produto_id, tipo, quantidade, data_hora) "
                    "VALUES (?, 'ENTRADA', ?, ?)",
                    (produto_id, int(quantidade),
                     datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
                )

        print(f"\n  [OK] Produto '{nome}' cadastrado! (ID: {produto_id})")
        return produto_id

    except sqlite3.IntegrityError:
        # NOVO: captura violação de UNIQUE (nome + categoria duplicados)
        print(f"  [ERRO] Produto '{nome}' na categoria '{categoria}' já existe no sistema.")
        return None


def registrar_entrada(produto_id, quantidade):
    """Aumenta o saldo e registra no histórico — tudo na mesma transação."""
    if quantidade <= 0:
        print("  [ERRO] A quantidade de entrada deve ser maior que zero.")
        return

    try:
        with get_conn() as conn:
            produto = conn.execute(
                "SELECT * FROM produtos WHERE id = ?", (produto_id,)
            ).fetchone()

            if produto is None:
                print(f"  [ERRO] Produto ID {produto_id} não encontrado.")
                return

            novo_saldo = produto["quantidade"] + quantidade

            # CORREÇÃO: UPDATE + INSERT na mesma conexão/transação
            conn.execute(
                "UPDATE produtos SET quantidade = ? WHERE id = ?",
                (novo_saldo, produto_id)
            )
            conn.execute(
                "INSERT INTO movimentacoes (produto_id, tipo, quantidade, data_hora) "
                "VALUES (?, 'ENTRADA', ?, ?)",
                (produto_id, quantidade, datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
            )

        print(f"\n  [OK] +{quantidade} unidade(s) de '{produto['nome']}'. Saldo: {novo_saldo}.")

    except Exception as exc:
        logging.error("registrar_entrada(%s, %s): %s", produto_id, quantidade, exc)
        print("  [ERRO] Falha ao registrar entrada. Consulte o log.")


def registrar_saida(produto_id, quantidade):
    """Reduz o saldo com verificação de suficiência — transação atômica."""
    if quantidade <= 0:
        print("  [ERRO] A quantidade de saída deve ser maior que zero.")
        return

    try:
        with get_conn() as conn:
            produto = conn.execute(
                "SELECT * FROM produtos WHERE id = ?", (produto_id,)
            ).fetchone()

            if produto is None:
                print(f"  [ERRO] Produto ID {produto_id} não encontrado.")
                return

            if quantidade > produto["quantidade"]:
                print(f"  [ERRO] Estoque insuficiente. "
                      f"Disponível: {produto['quantidade']} unidade(s).")
                return

            novo_saldo = produto["quantidade"] - quantidade

            conn.execute(
                "UPDATE produtos SET quantidade = ? WHERE id = ?",
                (novo_saldo, produto_id)
            )
            conn.execute(
                "INSERT INTO movimentacoes (produto_id, tipo, quantidade, data_hora) "
                "VALUES (?, 'SAIDA', ?, ?)",
                (produto_id, quantidade, datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
            )

        print(f"\n  [OK] -{quantidade} unidade(s) de '{produto['nome']}'. Saldo: {novo_saldo}.")

    except Exception as exc:
        logging.error("registrar_saida(%s, %s): %s", produto_id, quantidade, exc)
        print("  [ERRO] Falha ao registrar saída. Consulte o log.")


def consultar_estoque(produto_id):
    """Exibe ficha completa do produto."""
    with get_conn() as conn:
        p = conn.execute(
            "SELECT * FROM produtos WHERE id = ?", (produto_id,)
        ).fetchone()

    if p is None:
        print(f"  [ERRO] Produto ID {produto_id} não encontrado.")
        return None

    print("\n  " + "─" * 42)
    print(f"  ID         : {p['id']}")
    print(f"  Nome       : {p['nome']}")
    print(f"  Categoria  : {p['categoria']}")
    print(f"  Preço      : R$ {p['preco']:.2f}")
    print(f"  Quantidade : {p['quantidade']} unidade(s)")
    print(f"  Valor em estoque: R$ {p['preco'] * p['quantidade']:.2f}")
    print("  " + "─" * 42)
    return dict(p)


def alertar_estoque_baixo(limite):
    """Lista produtos com saldo abaixo do limite."""
    if limite < 0:
        print("  [ERRO] O limite não pode ser negativo.")
        return

    with get_conn() as conn:
        criticos = conn.execute(
            "SELECT * FROM produtos WHERE quantidade < ? ORDER BY quantidade ASC",
            (limite,)
        ).fetchall()

    if not criticos:
        print(f"\n  [OK] Nenhum produto abaixo de {limite} unidade(s).")
        return

    print(f"\n  ⚠  ALERTA — Estoque crítico (< {limite} unidade(s)):")
    print("  " + "─" * 52)
    print(f"  {'ID':<6} {'Nome':<22} {'Categoria':<14} {'Qtd':>5}")
    print("  " + "─" * 52)
    for p in criticos:
        print(f"  {p['id']:<6} {p['nome']:<22} {p['categoria']:<14} {p['quantidade']:>5}")
    print("  " + "─" * 52)
    print(f"  {len(criticos)} produto(s) em situação crítica.")


